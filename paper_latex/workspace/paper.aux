\newlabel{tab:main}{{1}{7}{FOL accuracy on FOLIO test set. \textbf {EM} = exact-match; \textbf {z3 Equiv.} = logical equivalence via SMT solver. Best result in bold. $\dagger $ indicates $p < 0.001$ vs.\ B1 and B3 (bootstrap resampling)}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Learned transmission rates for the 12 most frequent UD dependency relation types after L-BFGS-B optimization on the FOLIO training set. Core grammatical relations (nsubj, dobj) learn high $\beta $; modification edges (amod, advmod) learn intermediate $\beta $; clause-boundary edges (relcl, advcl, ccomp) converge to near-zero, confirming the scope-island hypothesis. Dashed horizontal lines mark the high-$\beta $ (0.70) and low-$\beta $ (0.10) thresholds.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:fig5}{{2}{7}{Learned transmission rates for the 12 most frequent UD dependency relation types after L-BFGS-B optimization on the FOLIO training set. Core grammatical relations (nsubj, dobj) learn high $\beta $; modification edges (amod, advmod) learn intermediate $\beta $; clause-boundary edges (relcl, advcl, ccomp) converge to near-zero, confirming the scope-island hypothesis. Dashed horizontal lines mark the high-$\beta $ (0.70) and low-$\beta $ (0.10) thresholds}{figure.2}{}}
